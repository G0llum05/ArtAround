  "items": [
    {
      "key": "item_archeo_athena_advanced",
      "description": "La testa di Athena Lemnia conservata al Museo Civico Archeologico di Bologna è considerata uno dei massimi capolavori della ritrattistica classica greca. Tratta dalla celebre statua bronzea scolpita da Fidia nel V sec. a.C. per l'Acropoli di Atene, la scultura esprime l'armonia ideale del volto divino senza elmo, con la fascia tra i capelli e uno sguardo di maestosa serenità.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_archeo_situla_medium",
      "description": "La Situla Benvenuti (VI sec. a.C.) è il reperto più celebre della civiltà etrusca di Felsina. Questo recipiente rituale in lamina di bronzo sbalzata è decorato su tre registri sovrapposti con scene di animali fantastici, sfilate di guerrieri con scudi rotondi e cerimonie di banchetto nobilitante.",
      "tone": "medium",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_archeo_horemheb_scientific",
      "description": "I grandi bassorilievi in pietra calcarea provenienti dalla tomba di Horemheb a Saqqara (prima del suo insediamento come Faraone) raffigurano prigionieri asiatici e libici scortati da soldati egizi. Le incisioni testimoniano lo stile raffinato dell'arte menfita post-amarniana del Nuovo Regno.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_archeo_stele_medium",
      "description": "Le stele funerarie etrusche di Felsina in pietra d'arenaria ('Pietra d'Aria') raffigurano il viaggio figurato del defunto verso l'Oltretomba su una biga condotta da un demone psicopompo, circondata da mostri marini e serpentiformi della tradizione etrusca.",
      "tone": "medium",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_archeo_nespamedu_technical",
      "description": "La statua bronzea del sacerdote Nespamedu risale all'Epoca Saitica dell'Egitto antico (VII-VI sec. a.C.). La figura è impreziosita da una finissima ageminatura in filo d'oro e d'argento che traccia le geroglifici di invocazione alle divinità dell'Oltretomba.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_archeo_elmo_simple",
      "description": "Questo grande elmo di bronzo a cresta apparteneva a un valoroso guerriero villanoviano vissuto a Bologna quasi 2800 anni fa! Le decorazioni a punti sbalzati mostrano l'incredibile abilità dei primi fabbri bolognesi dell'Età del Ferro.",
      "tone": "simple",
      "length": 60,
      "language": "it"
    }
  ],
