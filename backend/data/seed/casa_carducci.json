  "items": [
    {
      "key": "item_carducci_studio_medium",
      "description": "Lo studio di Giosuè Carducci è il cuore pulsante di Casa Carducci. Conservato esattamente come il poeta lo lasciò prima della morte nel 1907, comprende la grande scrivania in legno di noce con piano in pelle, gli occhiali da lettura, le calamaie e migliaia di volumi consultati durante la stesura delle sue più grandi composizioni e le lezioni universitarie.",
      "tone": "medium",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_carducci_nobel_advanced",
      "description": "Nel dicembre 1906 l'Accademia svedese conferì a Giosuè Carducci il Premio Nobel per la Letteratura, primo italiano a ricevere tale riconoscimento. Il diploma in pergamena finemente miniata e la medaglia d'oro originale in 24 carati rappresentano una testimonianza tangibile dell'impatto universale del suo genio poetico ed erudito.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_carducci_monumento_scientific",
      "description": "Il complesso monumentale scolpito in marmo di Carrara dal maestro simbolista Leonardo Bistolfi tra il 1912 e il 1928 domina il giardino di Casa Carducci. L'opera fonde plasticità liberty e tensione morale simbolista, figurando l'allegoria della Natura, della Poesia e del Vate risorgimentale.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_carducci_biblioteca_medium",
      "description": "La biblioteca personale di Carducci ospita circa 40.000 volumi, tra cui incunaboli, cinquecentine, rare edizioni dei classici latini e greci ed epistolari dei principali intellettuali europei dell'Ottocento. Un patrimonio inestimabile donato alla città di Bologna dal mecenate Alberto Pasolini.",
      "tone": "medium",
      "length": 60,
      "language": "it"
    },
    {
      "key": "item_carducci_manoscritto_advanced",
      "description": "Questo manoscritto autografo contiene le stesure originali delle 'Odi Barbare' con le famose annotazioni e correzioni a margine di Carducci. Mostra il lavoro filologico sulla metrica quantitativa latina trasposta nella poesia italiana moderna.",
      "tone": "technical",
      "length": 60,
      "language": "it"
    }
  ],
